# ============================================
# Azure OpenAI Configuration
# ============================================
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_KEY=your-api-key
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ============================================
# Azure DevOps Configuration
# ============================================
AZURE_DEVOPS_PAT=your-pat-token-with-code-rw-and-workitems-scopes
AZURE_DEVOPS_ORG=ecommerce

# ============================================
# Azure Storage Configuration
# ============================================
STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=...

# ============================================
# Project to Repository Mapping
# ============================================
PROJECT_REPO_MAP={"WebshopMain":"https://dev.azure.com/ecommerce/WebshopMain/_git/nuxt-webshop"}

# ============================================
# Webhook Security
# ============================================
WEBHOOK_SECRET=your-super-secret-webhook-key-change-this

# ============================================
# Queue Configuration
# ============================================
QUEUE_NAME=ai-coder-tasks
DEAD_LETTER_QUEUE_NAME=ai-coder-tasks-dlq
MAX_RETRIES=3

# ============================================
# NEW: Nuxt.js & Workflow Configuration
# ============================================
NUXT_PROJECTS=["WebshopMain"]
PR_DRAFT_BY_DEFAULT=true
AUTO_CLOSE_WORK_ITEMS=false
ADD_PR_COMMENT=true
